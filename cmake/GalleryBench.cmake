set(ENV{AINO_BENCH} 6)
unset(ENV{AINO_BENCH_RUN})
unset(ENV{AINO_PROF})
foreach(page buttons input)
    set(ENV{AINO_START_PAGE} "${page}")
    set(log "${CMAKE_CURRENT_BINARY_DIR}/bench-${page}.log")
    set(ENV{AINO_FRAME_LOG} "${log}")
    execute_process(COMMAND "${EXE}" RESULT_VARIABLE result TIMEOUT 20)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "gallery ${page}: exit ${result}")
    endif()
    file(READ "${log}" report)
    if(NOT report MATCHES "n=6  draws=9")
        message(FATAL_ERROR "gallery callback/sample count mismatch: ${report}")
    endif()
    message(STATUS "${report}")
endforeach()

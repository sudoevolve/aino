# 这些离屏夹具明确使用 GDI；文件名包含 macos 不代表原生 macOS 覆盖。
if(WIN32)
    foreach(_probe interaction widget overlay example_ui pomodoro macos_gallery newcomp
                   shadow_text measure click scrollbar gate_order bigfeat hover_fade)
        aino_add_test(${_probe} tools/probe/${_probe}_probe.cpp)
    endforeach()
    aino_add_test(edit NATIVE tools/probe/edit_probe.cpp)
    if(TARGET aino_ssh)
        aino_add_test(ssh_ui tools/probe/example_ui_probe.cpp)
        target_compile_definitions(aino_test_ssh_ui PRIVATE AINO_PROBE_SSH NOMINMAX)
        get_target_property(_ssh_includes aino_ssh INCLUDE_DIRECTORIES)
        get_target_property(_ssh_libraries aino_ssh LINK_LIBRARIES)
        target_include_directories(aino_test_ssh_ui PRIVATE ${_ssh_includes})
        target_link_libraries(aino_test_ssh_ui PRIVATE ${_ssh_libraries})
        if(MSVC)
            get_target_property(_ssh_crt aino_ssh MSVC_RUNTIME_LIBRARY)
            set_target_properties(aino_test_ssh_ui PROPERTIES MSVC_RUNTIME_LIBRARY "${_ssh_crt}")
        endif()
    endif()
endif()

